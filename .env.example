# 로컬 개발용 값만 작성한다. 실제 비밀번호·API 키·AWS 자격 증명은 넣지 않는다.

# 로컬에서 실제 사업자등록번호 없이 회원가입 플로우를 테스트하고 싶을 때만 주석을 풀어 사용한다.
# 국세청 사업자상태 조회를 건너뛰고 항상 통과시키므로, 운영 환경에는 절대 설정하지 않는다.
# spring.profiles.active=local
DB_NAME=memme
DB_USERNAME=memme
DB_PASSWORD=change-me
DB_PORT=3306
DB_URL=jdbc:mysql://localhost:3306/memme?serverTimezone=Asia/Seoul&characterEncoding=UTF-8

# 스키마 적용·기존 Worker 드레인·공유 원본 저장소 확인 뒤 명시적으로 켠다.
SALES_OUTBOX_ENABLED=false
SALES_OUTBOX_DISPATCH_ENABLED=true

# ECS 역할별로 기존 SPRING_PROFILES_ACTIVE 뒤에 하나만 추가한다.
# web: sales-outbox-web (Dispatcher false), batch: sales-outbox-batch (true).
# 기존 production-redis/production-pool-evict 프로필을 제거하지 않는다.
# 역할 프로필은 Outbox를 자동 활성화하지 않는다. 상세: docs/sales-outbox-runtime.md

# 공공데이터포털 사업자등록번호 상태 조회 API 일반 인증키
NTS_SERVICE_KEY=

# 공공데이터포털 기상청 날씨 API 인증키
DATA_GO_KR_SERVICE_KEY=

# 기상청 API허브 특보현황 조회 API 인증키.
KMA_API_HUB_AUTH_KEY=

# 서울 열린데이터광장 상권분석 Open API 인증키
SEOUL_OPEN_DATA_API_KEY=

# 카카오맵 Local REST API 키(주소를 좌표로 변환)
KAKAO_REST_API_KEY=

# 행정안전부 실시간 주소정보 조회(검색 API) 승인키(confmKey)
JUSO_CONFM_KEY=

# Gmail SMTP 메일 발송 설정(비밀번호 재설정 링크 발송용)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# 비밀번호 재설정 이메일 링크가 열 프론트 화면 주소
PASSWORD_RESET_URL=http://localhost:5173/password-reset
# 브라우저에서 BE API를 호출할 프론트 주소. 여러 주소는 쉼표로 구분한다.
# 배포 환경에는 실제 HTTPS 프론트 주소를 명시한다. 끝에 /를 붙이지 않는다.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# 요청 키는 HMAC 처리 후 저장한다. 비워 두면 DB_PASSWORD를 해시 키로 사용한다.
# 운영에서는 모든 BE 인스턴스가 공유하는 별도의 강한 임의 비밀값을 권장한다.
PASSWORD_RESET_RATE_LIMIT_HASH_KEY=
# 로그인 제한 식별자도 HMAC 처리해 저장한다. 운영에서는 모든 BE 인스턴스에 같은 강한 키를 설정한다.
# 비워 두면 DB_PASSWORD를 해시 키로 사용한다.
LOGIN_RATE_LIMIT_HASH_KEY=
# 로컬 직접 접속은 false. 운영에서는 ALB 경유 및 백엔드 인바운드 제한을 확인한 경우에만 true.
TRUST_X_FORWARDED_FOR=false
# 제한 요청 이력 정리 주기(기본값: 5분마다)
PASSWORD_RESET_RATE_LIMIT_CLEANUP_CRON=0 */5 * * * *
LOGIN_RATE_LIMIT_CLEANUP_CRON=0 */5 * * * *

# 배포 환경 QA 점주 계정 초기화. 필요한 환경에서 한 번만 true로 활성화한다.
# 비밀번호는 8~20자이며 대문자·소문자·숫자·특수문자를 각각 포함해야 한다.
QA_ACCOUNT_ENABLED=false
QA_ACCOUNT_EMAIL=
QA_ACCOUNT_PASSWORD=
QA_ACCOUNT_PHONE=
QA_ACCOUNT_BUSINESS_REGISTRATION_NO=
QA_ACCOUNT_STORE_NAME=MEMME QA
QA_ACCOUNT_POSTAL_CODE=06236
QA_ACCOUNT_ADDRESS=서울특별시 강남구 테헤란로 123
QA_ACCOUNT_ADDRESS_DETAIL=

# 배포 환경에서 memme.kr과 api.memme.kr이 CSRF 쿠키를 공유할 때만 memme.kr로 설정한다.
CSRF_COOKIE_DOMAIN=
# 로컬 HTTP는 false, 운영 HTTPS는 true로 설정한다.
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_SAME_SITE=Lax

# AI 서버 내부 연동. 운영에서는 Cloud 담당자가 BE와 AI에 같은 토큰을 동시에 주입한다.
AI_BASE_URL=http://localhost:8000
INTERNAL_AI_TOKEN=
AI_CONNECT_TIMEOUT_SECONDS=3
AI_READ_TIMEOUT_SECONDS=30
# 메뉴판 1~10장 동기 분석용. 실제 처리 시간을 측정해 BE·AI·프록시 제한 시간을 함께 맞춘다.
MENU_AI_CONNECT_TIMEOUT_SECONDS=3
MENU_AI_READ_TIMEOUT_SECONDS=120

# 매출 원본 파일 저장소. 기본값은 local이며, 운영에서 s3 사용 시 bucket을 필수로 설정한다.
SALES_STORAGE_TYPE=local
SALES_STORAGE_S3_BUCKET=
SALES_STORAGE_S3_REGION=ap-northeast-2
SALES_STORAGE_S3_ENDPOINT=
SALES_STORAGE_S3_PATH_STYLE_ACCESS=false

# 메뉴판 원본 이미지 저장소. 외부 AI가 이미지에 접근하려면 s3와 비공개 bucket을 사용한다.
MENU_STORAGE_TYPE=local
MENU_STORAGE_LOCAL_DIRECTORY=/tmp/memme-menu-images
MENU_STORAGE_S3_BUCKET=
MENU_STORAGE_S3_REGION=ap-northeast-2
MENU_STORAGE_S3_ENDPOINT=
MENU_STORAGE_S3_PATH_STYLE_ACCESS=false

# 매일 오늘의 솔루션을 생성하는 스케줄(Asia/Seoul)
SOLUTION_DAILY_CRON=0 0 0 * * *

# ASOS 관측자료 최초 백필·매일 전일 갱신. 운영 배치 태스크에서만 true로 설정한다.
ASOS_OBSERVATION_IMPORT_ENABLED=false
ASOS_OBSERVATION_IMPORT_CRON=0 0 12 * * *

# 서울 상권 분기자료 최초 수집·신규 분기 재시도. 운영 배치 태스크에서만 true로 설정한다.
SEOUL_DISTRICT_IMPORT_ENABLED=false
SEOUL_DISTRICT_IMPORT_CRON=0 0 12 * * *

# 매일 오전 8시에 생성 완료된 오늘의 솔루션 알림을 발송하는 스케줄(Asia/Seoul)
SOLUTION_READY_NOTIFICATION_CRON=0 0 8 * * *

# 매일 오전 8시에 매출 업로드 리마인더를 발송하는 스케줄(Asia/Seoul)
SALES_UPLOAD_REMINDER_CRON=0 0 8 * * *

# Sentry 백엔드 오류 모니터링. 로컬에서는 비워 두면 전송하지 않는다.
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
